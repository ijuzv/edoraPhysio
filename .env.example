# Local preview stays unindexed; set these only after launch review.
PORT=3000
SITE_URL=
PUBLIC_INDEXING=false
# Enable only after privacy/terms and service copy are approved.
BOOKING_ENABLED=false
# HTTPS endpoint operated by your chosen notification provider.
# Receives booking/feedback data; must durably accept before returning 2xx.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=
# At least 24 characters. Never place this key in client files.
PRACTITIONER_KEY=

# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
