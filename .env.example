# Supabase Configuration
# Get these from https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp Cloud API Configuration
# Get these from https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# Site Configuration
# Local preview stays unindexed; set these only after launch review.
SITE_URL=
PUBLIC_INDEXING=false

# Practitioner Access
# At least 24 characters. Never place this key in client files.
PRACTITIONER_KEY=

# Legacy Configuration (kept for backwards compatibility, no longer used)
BOOKING_ENABLED=false
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_TOKEN=

# Security
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
