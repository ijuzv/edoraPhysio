# Supabase Configuration
# Get these from https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Twilio WhatsApp Configuration
# Get these from the Twilio Console.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Site Configuration
# Local preview stays unindexed; set these only after launch review.
SITE_URL=
PUBLIC_INDEXING=false

# Practitioner Access
# At least 24 characters. Never place this key in client files.
PRACTITIONER_KEY=

# Legacy Configuration (kept for backwards compatibility, no longer used)
BOOKING_ENABLED=false

# Security
# Enable only behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
